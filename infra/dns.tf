# Only the records this stack changes are managed here; every other record in the zone is left alone.
# At cutover the existing www/apex records are adopted with import blocks generated by tools/cfimport (import.tf).

resource "cloudflare_dns_record" "www" {
  count   = var.cutover ? 1 : 0
  zone_id = var.zone_id
  name    = var.site_host
  type    = "CNAME"
  content = "${var.pages_project}.pages.dev"
  proxied = true
  ttl     = 1
  comment = "managed by terraform: nexovia-site"
}

# Apex only needs to exist and be proxied; the redirect rule sends it to www.
resource "cloudflare_dns_record" "apex" {
  zone_id = var.zone_id
  name    = var.apex
  type    = "AAAA"
  content = "100::"
  proxied = true
  ttl     = 1
  comment = "managed by terraform: proxied placeholder, redirected to www"
}

resource "cloudflare_dns_record" "caa_issue" {
  for_each = toset(var.caa_issuers)
  zone_id  = var.zone_id
  name     = var.apex
  type     = "CAA"
  ttl      = 3600
  data = {
    flags = 0
    tag   = "issue"
    value = each.value
  }
  comment = "managed by terraform"
}

resource "cloudflare_dns_record" "caa_iodef" {
  zone_id = var.zone_id
  name    = var.apex
  type    = "CAA"
  ttl     = 3600
  data = {
    flags = 0
    tag   = "iodef"
    value = "mailto:${var.caa_report_email}"
  }
  comment = "managed by terraform"
}
